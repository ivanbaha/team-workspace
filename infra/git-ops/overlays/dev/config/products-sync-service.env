# products-sync-service — dev
# Generated into a ConfigMap by this overlay's configMapGenerator. Every key here
# reaches the container through envFrom, so a key removed here is a variable the
# service no longer sees on its next roll.

LOGGER_FORMAT=json
LOGGER_LEVEL=debug
NODE_ENV=development
PORT=4003
PRODUCTS_SERVICE_URL=http://products-service
CACHE_TTL=300
BATCH_DELAY_SECONDS=5
LOCK_TTL_SECONDS=10
BATCH_SIZE=100