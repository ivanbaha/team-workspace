{
  "name": "workspace-mcp",
  "version": "1.0.0",
  "description": "MCP server for team-workspace workflow tools including GitLab and Jira integration",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "workspace-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:dev": "node node_modules/@modelcontextprotocol/inspector/cli/build/cli.js node src/index.js",
    "docs:ingest": "node scripts/ingest-docs.mjs",
    "docs:sources": "node scripts/list-sources.mjs",
    "docs:query": "node scripts/search-docs.mjs",
    "docs:health": "node scripts/docs-health.mjs",
    "docs:eval": "node scripts/docs-eval.mjs",
    "docs:download-model": "node scripts/download-model.mjs",
    "docs:reset": "node scripts/docs-reset.mjs",
    "qdrant": "node scripts/qdrant.mjs",
    "qdrant:up": "node scripts/qdrant.mjs up",
    "qdrant:down": "node scripts/qdrant.mjs stop",
    "qdrant:logs": "node scripts/qdrant.mjs logs",
    "qdrant:status": "node scripts/qdrant.mjs status"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "mongodb": "7.4.0",
    "nestjs-env-getter": "1.2.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.2.0",
    "@qdrant/js-client-rest": "1.18.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "0.22.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
