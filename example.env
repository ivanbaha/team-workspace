# GitLab Integration Config
# Personal Access Token with api, read_user, read_repository scopes
GITLAB_PAT='glpat-xxxxxxxxxxxxxxxxxxxx'
# Target GitLab instance base URL (default: https://gitlab.company.internal/)
GITLAB_BASE_URL='https://gitlab.company.internal/'

# Jira Integration Config
# Personal Access Token with read/write permissions
JIRA_PAT='xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
# Target Jira instance base URL (default: https://jira.company.internal)
JIRA_BASE_URL='https://jira.company.internal'

# Grafana Integration Config
# JSON object mapping environment names to their credentials (pat is service account token, url is optional)
GRAFANA_ENVS='{
  "test": {
    "pat": "glsa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  },
  "prod": {
    "pat": "glsa_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy",
    "url": "https://grafana.company.internal/"
  }
}'

# MongoDB Integration Config
# JSON object mapping environment names to their connection strings
MONGODB_ENVS='{
  "test": {
    "connectionString": "mongodb+srv://user:pass@cluster-test.mongodb.net/"
  },
  "prod": {
    "connectionString": "mongodb+srv://user:pass@cluster-prod.mongodb.net/"
  }
}'

# ============================================================================
# Documentation Hybrid Search (docs_search) — opt-in
# ============================================================================
# Off by default. When disabled the tool is omitted from the MCP tool list
# entirely, so the agent never sees it and cannot call it; docs_map keeps
# working at zero cost with no infrastructure at all.
DOCS_SEARCH_ENABLED=true

# ── Qdrant ──────────────────────────────────────────────────────────────────
# Endpoint of the local vector store (auto-started on MCP server startup).
QDRANT_URL='http://127.0.0.1:6333'
# Container engine used to auto-start Qdrant. Supported:
#   docker    Docker Desktop / Engine, and anything providing the docker CLI
#             (Colima, Rancher Desktop, Lima)
#   podman    daemonless + rootless; the usual answer when Desktop is unlicensed
#   nerdctl   containerd's CLI (Rancher Desktop, Lima, k3s)
#   wslc      Windows, WSL >= 2.9.3 built-in engine — no Docker Desktop
#   container Apple's native container tool (macOS 26+, Apple silicon)
#   external  managed elsewhere (bare binary, shared/remote instance) — the
#             workspace never starts or stops it
# See docs/guides/qdrant-runtimes.md for how to choose.
QDRANT_ENGINE='docker'
# Qdrant ALIAS name. Search always queries the alias; ingest builds a new
# timestamped collection and swaps the alias atomically (blue-green), so a
# rebuild never exposes a partial index.
DOCS_RAG_COLLECTION='workspace_docs'

# ── Embedding model (dense half) ────────────────────────────────────────────
# Runs in-process via ONNX (Transformers.js) — no Python, no cloud API, no GPU.
DOCS_RAG_MODEL='Snowflake/snowflake-arctic-embed-m-v1.5'
# Quantization: q8 (int8, ~106MB, the default) or fp32 (4x the memory, no
# measurable gain at this corpus size). NOTE: v3+ selects this via `dtype`;
# the old `{ quantized: true }` option is accepted and silently ignored.
DOCS_RAG_DTYPE='q8'
# Dense vector size. MUST match the model AND the Qdrant collection — changing
# the model without changing this produces a dimension mismatch at ingest.
DOCS_RAG_DIM=768

# ── Chunking & ingest ───────────────────────────────────────────────────────
# Target max chunk size in characters. A TARGET, not a hard limit: tables and
# fenced code blocks are never split, even when that overshoots the cap.
DOCS_RAG_CHUNK_MAX=1000
# Embedding batch size during ingest. Lower it to reduce the peak CPU/memory
# spike on a constrained machine, at the cost of a longer rebuild.
DOCS_RAG_BATCH=32
# Timeout for a setup-driven ingest before it is SIGTERMed (default 20 min).
DOCS_INGEST_TIMEOUT_MS=1200000

# ── Paths (all git-ignored, self-contained under mcp/) ──────────────────────
# BM25 model + ingest state. Defaults to mcp/.docs-index
# DOCS_RAG_INDEX_DIR='./mcp/.docs-index'
# Corpus root for ingestion. Defaults to the workspace root.
# DOCS_RAG_WORKSPACE='.'

# ── docs_map (the zero-dependency outline tool, always on) ──────────────────
# Deepest heading level reported in the table of contents. Note that docs_search
# indexes every heading level regardless — the two tools have different scopes
# on purpose, which is occasionally surprising.
DOCS_MAP_MAX_HEADING_LEVEL=3
# Root directory docs_map walks. Defaults to the workspace `docs/` directory —
# docs_map covers docs/ only, while docs_search covers the wider curated corpus.
# DOCS_RAG_PATH='./docs'

# ── Performance tuning on constrained machines ──────────────────────────────
# Cap ONNX runtime threads to bound the ingest CPU spike (trades rebuild speed).
# OMP_NUM_THREADS=4
# Refuse any network fetch — the model cache must already be warm. Enforces the
# "fully offline after first setup" property.
# TRANSFORMERS_OFFLINE=1
