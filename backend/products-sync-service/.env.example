PORT=4003
# Must be the same secret as users-service — it issues the tokens this service verifies.
JWT_SECRET=changeme

# Upstream products-service, called to recompute per-category stats.
PRODUCTS_SERVICE_URL=http://localhost:4002

# ── Tracing & logging (@tw/logger, @tw/http-connector) ──────────────────────
# Name this service logs under AND sends as User-Agent. MUST equal the container
# name: it is what the receiving service records as `caller`, which is the only
# edge information a trace has.
DEPLOYMENT_NAME=products-sync-service
# POD_NAME=products-sync-service-7d4f8c9b6-x2k9p

LOGGER_LEVEL=info
LOGGER_FORMAT=pretty
# LOGGER_REQUEST_LOGGING=compact

# ── Shared cache (@tw/cache, operator role) ─────────────────────────────────
# This service OWNS the category-stats entries and RUNS the work queue: the
# Redis Set IS the queue, SET NX EX is the batch lock. In the cluster it
# connects with a read-write user scoped to its own prefix. Same server as
# every participant, or nothing here will ever hit. Unset → in-process store
# (nothing shared — and the queue becomes single-process too).
# CACHE_URL=redis://products-sync-service:password@localhost:6379
# Entry TTL in seconds — the only TTL unit. Keep the `?? 300` fallback in code:
# Number(undefined) is NaN, and NaN is a boot-time configuration error.
CACHE_TTL=300

# ── Batch worker ────────────────────────────────────────────────────────────
# Seconds after a request before the batch drain runs. Everything accepted in
# the window collapses into one batch; the milliseconds are derived from this
# one constant in code, never written by hand.
BATCH_DELAY_SECONDS=5
# Seconds the scheduling lock lives. Should cover the delay window, so a burst
# of requests collapses into one drain. The drain releases the lock when it
# finishes and re-checks the queue; the TTL is the release only for a holder
# that crashed.
LOCK_TTL_SECONDS=10
# Category ids per pop of the queue set.
BATCH_SIZE=100
# Seconds between reconcile passes: queued ids with no drain scheduled (a
# crash, a cache outage, an evicted lock, a boot before the cache connected)
# get one within this long.
RECONCILE_INTERVAL_SECONDS=30
# Most ids the queue may hold. The queue set has no TTL, so it is never
# evicted — which also means it must never be allowed to grow without bound.
MAX_QUEUE_SIZE=10000