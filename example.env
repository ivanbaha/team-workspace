# GitLab Integration Config
# Personal Access Token with api, read_user, read_repository scopes
GITLAB_PAT='glpat-xxxxxxxxxxxxxxxxxxxx'
# Target GitLab instance base URL (default: https://gitlab.company.internal/)
GITLAB_BASE_URL='https://gitlab.company.internal/'

# Jira Integration Config
# Personal Access Token with read/write permissions
JIRA_PAT='xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
# Target Jira instance base URL (default: https://jira.company.internal)
JIRA_BASE_URL='https://jira.company.internal'

# Grafana Integration Config
# JSON object mapping environment names to their credentials (pat is service account token, url is optional)
GRAFANA_ENVS='{
  "test": {
    "pat": "glsa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  },
  "prod": {
    "pat": "glsa_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy",
    "url": "https://grafana.company.internal/"
  }
}'

# MongoDB Integration Config
# JSON object mapping environment names to their connection strings
MONGODB_ENVS='{
  "test": {
    "connectionString": "mongodb+srv://user:pass@cluster-test.mongodb.net/"
  },
  "prod": {
    "connectionString": "mongodb+srv://user:pass@cluster-prod.mongodb.net/"
  }
}'

# Documentation Hybrid Search Config (Opt-in)
# Enable semantic + keyword search over documentation (default: false)
DOCS_SEARCH_ENABLED=true
# Local Qdrant server endpoint (default: http://127.0.0.1:6333)
QDRANT_URL='http://127.0.0.1:6333'
# Container engine to automatically run Qdrant. Options: docker, wslc (default: docker)
QDRANT_ENGINE='docker'
# Embedding model ID (default: Snowflake/snowflake-arctic-embed-m-v1.5)
DOCS_RAG_MODEL='Snowflake/snowflake-arctic-embed-m-v1.5'
# Collection alias used in Qdrant (default: workspace_docs)
DOCS_RAG_COLLECTION='workspace_docs'
