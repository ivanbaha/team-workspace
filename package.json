{
  "name": "team-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo workspace for the development team — frontend microfrontends, backend services, infrastructure, and documentation.",
  "workspaces": [
    "frontend/*",
    "backend/*",
    "libs/*"
  ],
  "scripts": {
    "setup": "node scripts/setup-workspace.mjs",
    "update": "node scripts/update-workspace.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "rules:sync": "node scripts/sync-agent-rules.mjs",
    "rules:check": "node scripts/sync-agent-rules.mjs --check",
    "skills:sync": "node scripts/sync-skill-wrappers.mjs",
    "skills:check": "node scripts/sync-skill-wrappers.mjs --check",
    "agents:check": "yarn rules:check && yarn skills:check",
    "build:libs": "yarn workspace @tw/tracing build && yarn workspace @tw/logger build && yarn workspace @tw/http-connector build",
    "test:libs": "yarn workspace @tw/tracing test && yarn workspace @tw/logger test && yarn workspace @tw/http-connector test",
    "daily-setup": "node scripts/daily-setup-guard.mjs",
    "gitops:versions": "node .ai/skills/release-mr/scripts/read-versions.mjs --all",
    "gitops:validate": "node .ai/skills/release-mr/scripts/validate-overlays.mjs",
    "docs:ingest": "yarn --cwd mcp docs:ingest",
    "docs:health": "yarn --cwd mcp docs:health",
    "docs:eval": "yarn --cwd mcp docs:eval",
    "docs:query": "yarn --cwd mcp docs:query",
    "docs:sources": "yarn --cwd mcp docs:sources",
    "qdrant": "yarn --cwd mcp qdrant",
    "dev:host": "yarn workspace host-frontend dev",
    "dev:users-fe": "yarn workspace users-frontend dev",
    "dev:products-fe": "yarn workspace products-frontend dev",
    "dev:users-be": "yarn workspace users-service dev",
    "dev:products-be": "yarn workspace products-service dev",
    "lint": "yarn workspaces run lint",
    "build": "yarn workspaces run build"
  },
  "devDependencies": {}
}
