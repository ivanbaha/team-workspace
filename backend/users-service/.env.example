PORT=4001
JWT_SECRET=changeme

# ── Tracing & logging (@tw/logger) ──────────────────────────────────────────
# Name this service logs under. MUST equal the container name, or traces
# attribute its spans to nothing and it shows up as an orphaned root.
DEPLOYMENT_NAME=users-service
# Set from the Kubernetes downward API in a real deployment; unset locally.
# POD_NAME=users-service-b4799cf77-8t452

# error | warn | info | debug | verbose | silly
LOGGER_LEVEL=info
# json for anything that ships logs; pretty for a readable local terminal.
LOGGER_FORMAT=pretty
# off | compact | full. Defaults to compact (follows LOGGER_LEVEL), which is
# what traces need. `full` adds masked headers and bodies at silly level.
# LOGGER_REQUEST_LOGGING=compact
