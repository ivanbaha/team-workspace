#!/bin/sh
#
# .githooks/post-merge
#
# Fires after a `git pull` / `git merge` that brought commits.
# Delegates to the shared implementation, which syncs nested repos and — only
# if documentation markdown actually changed — schedules a docs index rebuild.
#
# Activated by `yarn hooks:install` (sets core.hooksPath to .githooks).

cd "$(git rev-parse --show-toplevel)" || exit 0
node .githooks/post-update.mjs post-merge
exit 0
