PORT=4002
# Must be the same secret as users-service — it issues the tokens this service verifies.
JWT_SECRET=changeme

# Upstream users-service, called to resolve product owners.
USERS_SERVICE_URL=http://localhost:4001

# ── Tracing & logging (@tw/logger, @tw/http-connector) ──────────────────────
# Name this service logs under AND sends as User-Agent. MUST equal the container
# name: it is what the receiving service records as `caller`, which is the only
# edge information a trace has.
DEPLOYMENT_NAME=products-service
# POD_NAME=products-service-7d4f8c9b6-x2k9p

LOGGER_LEVEL=info
LOGGER_FORMAT=pretty
# LOGGER_REQUEST_LOGGING=compact
