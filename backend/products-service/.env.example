PORT=4002
# Must be the same secret as users-service — it issues the tokens this service verifies.
JWT_SECRET=changeme

# Upstream users-service, called to resolve product owners.
USERS_SERVICE_URL=http://localhost:4001

# ── Tracing & logging (@tw/logger, @tw/http-connector) ──────────────────────
# Name this service logs under AND sends as User-Agent. MUST equal the container
# name: it is what the receiving service records as `caller`, which is the only
# edge information a trace has.
DEPLOYMENT_NAME=products-service
# POD_NAME=products-service-7d4f8c9b6-x2k9p

LOGGER_LEVEL=info
LOGGER_FORMAT=pretty
# LOGGER_REQUEST_LOGGING=compact

# ── Shared cache (@tw/cache, owner + consumer) ───────────────────────────────
# This service is both roles: it OWNS the product, productList and request
# cache entries (read-write ACL user on its own prefix) and it READS the user
# entries owned by users-service (read-only, never writes them). Same server
# as every participant, or nothing here will ever hit. Unset → in-process
# store (nothing shared).
# CACHE_URL=redis://products-service:password@localhost:6379
# Entity/list entry TTL in seconds — the only TTL unit. Keep the `?? 60`
# fallback in code: Number(undefined) is NaN, and NaN is a boot-time
# configuration error.
CACHE_TTL=60
# Composite request cache TTL in seconds. This one is the ONLY invalidation
# the composite has — no write can name its key, so it self-heals on expiry.
REQUEST_CACHE_TTL=10
